# 巡检镜像：导轨控制 + 采图调度 + prod 接收 API（ADR-0012 §4：不背 torch/opencv/mlflow）
#
# 构建（在 WSL 里；构建上下文是**仓库根**）：
#   cd /mnt/d/code/mushroom
#   docker build -f docker/Dockerfile.patrol -t mushroom_patrol:dev .
#
# ## 为什么基础镜像是 trixie（而不是 bookworm）
#
# 厂商库 `libFMC4030_2009_1.so` 需要 **GLIBCXX_3.4.32**：
#
#   $ ldd /opt/fmc-lib/libFMC4030_2009_1.so
#   ... version `GLIBCXX_3.4.32' not found (required by ...libFMC4030_2009_1.so)
#
# Debian 12（bookworm，GCC 12）的 libstdc++ 只到 GLIBCXX_3.4.30 —— 2026-09-15 上机时
# 页面就是这么报错的（容器里 load 不了厂商库）。Debian 13（trixie，GCC 14）到 3.4.33，
# 与宿主 Ubuntu 24.04 一致。
#
# ⚠️ 教训：当初只核对了"它依赖哪些库"（readelf -d 显示只有 libstdc++/libc），**没核对
# 需要的符号版本**。`--dry-run` 预检现在会真的 load 一次这个库，把这类问题挡在部署前。
#
# ## ffmpeg
#
# 只有 `preview` 角色用得到（RTSP → MJPEG，ADR-0017）。宿主上没有 ffmpeg，转码放在容器里，
# 顺便让相机口令只存在于容器配置中。镜像因此大 ~80 MB —— 相比再引入一个转码服务，这更划算。
FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libstdc++6 \
      curl \
      ca-certificates \
      ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# uv 版本与开发机一致，保证 --frozen 用的是同一套锁语义
RUN pip install --no-cache-dir uv==0.12.10

# 容器里的目录结构与仓库一致：巡检项目是个独立 uv 项目，成员是上一级的 ../patrol 等，
# 照搬结构就不用为镜像另造一套路径（见 patrol-workspace/README.md）。
WORKDIR /srv
COPY patrol/ /srv/patrol/
COPY deploy/ /srv/deploy/
COPY measure/ /srv/measure/
COPY analysis/ /srv/analysis/
COPY patrol-workspace/pyproject.toml patrol-workspace/uv.lock /srv/patrol-workspace/
COPY docker/patrol-entrypoint.sh /usr/local/bin/patrol-entrypoint

# --frozen：完全按锁装，容器里绝不重新解析依赖（生产镜像的依赖必须是可复现的）
# --no-dev：不要 pytest/ruff
# --no-editable：把四个包真正装进 venv 的 site-packages，镜像自包含
RUN cd /srv/patrol-workspace \
 && uv sync --frozen --no-dev --no-editable \
 && chmod +x /usr/local/bin/patrol-entrypoint

ENV PATH=/srv/patrol-workspace/.venv/bin:$PATH \
    FMC4030_LIB_PATH=/opt/fmc-lib/libFMC4030_2009_1.so \
    PATROL_ROOM=/app/configs/room.yaml \
    PATROL_STATIONS=/app/configs/stations.yaml \
    PATROL_OUTBOX=/app/data/outbox.jsonl \
    PATROL_LOG=/app/Logs/m1.log \
    PATROL_CAPTURE_HOST=172.17.0.1:7003 \
    PATROL_INGEST=http://172.17.0.1:8000/ingest \
    PREVIEW_PORT=8003 \
    PREVIEW_SCALE=640 \
    PREVIEW_FPS=5

LABEL org.opencontainers.image.title="mushroom_patrol" \
      org.opencontainers.image.description="蘑菇房巡检：导轨控制 + 采图调度 + 接收 API"

ENTRYPOINT ["/usr/local/bin/patrol-entrypoint"]
CMD ["patrol"]
